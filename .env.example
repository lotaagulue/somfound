# Copy to .env and adjust for local dev. None of these are required to run
# the app — everything has a demo-safe default (see src/somfound/config.py).

# Moderator queue login (HTTP Basic)
MODERATOR_USERNAME=moderator
MODERATOR_PASSWORD=change-me

# Africa's Talking SMS gateway — for a real pilot deployment only, not the
# demo (their free sandbox is deprecated; use /sms/simulate for the demo).
# Leave blank until there's an actual production account.
AT_USERNAME=
AT_API_KEY=

# Defaults to a local SQLite file. To use Supabase Postgres instead (recommended
# on Vercel, where SQLite only survives within a warm instance — see README),
# use the Supavisor *transaction pooler* connection string from Supabase
# dashboard -> Project Settings -> Database -> Connection string -> "Transaction",
# NOT the direct connection (port 5432) — serverless needs the pooler (port 6543).
# DATABASE_URL=postgresql://postgres.xxxx:[password]@aws-x-region.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./somfound.db
